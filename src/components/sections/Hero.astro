---
import home from '../../content/pages/home.json';
import { sampleTypeScript } from '../../upgrade-watch';
import Button from '../ui/Button.astro';
const { hero } = home;
---
<section class="hero" id="top">
  <div class="hero-top">
    <div class="hero-title">
      <p class="t-eyebrow">{hero.eyebrow}</p>
      <h1 class="t-h1 balance">{hero.title}<span class="hero-muted">{hero.titleMuted}</span></h1>
    </div>
    <div class="side">
      <p class="t-body-m">{hero.description}</p>
      <Button href={hero.button.href}>{hero.button.label}</Button>
    </div>
  </div>
  <div class="hero-media">
    <div class="product" id="demo">
      <img class="bg" src={hero.background} alt={hero.backgroundAlt} width="1800" height="1000" fetchpriority="high" />
      <div class="script-tool">
        <form class="tool-inputs" id="script-check-form">
          <div class="tool-heading">
            <p class="t-eyebrow">On-chain inspection</p>
            <span class="tool-local">Read only · no wallet needed</span>
          </div>
          <div class="mode-row">
            <div class="sample-switch" role="group" aria-label="Choose what to inspect">
              <button type="button" data-inspect-mode="address" aria-pressed="false">Wallet address</button>
              <button type="button" data-inspect-mode="script" aria-pressed="true">Script JSON</button>
            </div>
            <label class="network-field">Network
              <select name="network" id="network-select"><option value="mainnet">Mainnet</option><option value="testnet">Testnet</option></select>
            </label>
          </div>
          <div class="editor-field" data-inspect-field="address" hidden>
            <label for="wallet-address">CKB wallet address</label>
            <input id="wallet-address" name="address" type="text" placeholder="ckb1… or ckt1…" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="address-hint" />
            <p class="field-hint" id="address-hint">Scans live cells and CKB capacity for this address. It is sent to this app's API and then to the selected public CKB provider.</p>
          </div>
          <div class="editor-field" data-inspect-field="script" hidden>
            <label for="script-json">Paste a CKB Script</label>
            <textarea id="script-json" name="script" rows="7" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="script-hint">{sampleTypeScript}</textarea>
            <p class="field-hint" id="script-hint">Example uses JoyID's published mainnet code hash. Analysis sends this Script to the app API and selected public CKB provider.</p>
            <div class="sample-switch sample-switch--examples" role="group" aria-label="Choose a script reference example">
              <button type="button" data-script-sample="type" aria-pressed="true">Type reference</button>
              <button type="button" data-script-sample="immutable" aria-pressed="false">Data reference</button>
            </div>
          </div>
          <button class="scan-button" id="inspect-submit" type="submit">Scan address</button>
          <p class="provider-note">Read-only lookup. No transaction is created or signed. Watchlist entries stay in this browser.</p>
        </form>
        <aside class="tool-result" aria-labelledby="result-title">
          <div class="result-head"><p class="t-eyebrow">Chain report</p><span class="result-state" id="result-state">Ready</span></div>
          <h2 class="result-title" id="result-title" aria-live="polite">Inspect a wallet or script</h2>
          <p class="result-period" id="result-summary">The report will show live cell data, the block snapshot and what the script reference proves.</p>
          <dl class="result-breakdown" id="result-breakdown" hidden></dl>
          <p class="check-status" id="check-status" role="status">No chain lookup has been made yet.</p>
          <section class="result-evidence" id="result-evidence" aria-label="On-chain evidence" hidden></section>
          <section class="result-scripts" id="result-scripts" aria-label="Scripts found in wallet" hidden></section>
          <button class="action-button action-primary" id="save-script" type="button" disabled>Save script</button>
          <div class="saved-scripts">
            <div class="saved-heading"><h3>Watchlist</h3><span>This device only</span></div>
            <p id="saved-empty" class="field-hint">No saved scripts yet.</p>
            <ul id="saved-script-list" aria-label="Scripts saved in this browser"></ul>
          </div>
        </aside>
      </div>
    </div>
    <div class="stats">
      {hero.stats.map((s) => (
        <div class="stat">
          <p class="t-num">{s.value}</p>
          <p class="t-eyebrow">{s.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<script>
  import { bindUpgradeWatch } from '../../upgrade-watch';
  bindUpgradeWatch();
</script>
<style>
  .hero { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 72px 20px 88px; display: flex; flex-direction: column; align-items: center; gap: 52px; }
  .hero-top { width: 100%; display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; }
  .hero-title { width: 600px; display: flex; flex-direction: column; gap: 22px; }
  .hero-muted { display: block; color: var(--dark-grey); }
  .side { width: 310px; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .side > p { align-self: stretch; }
  .hero-media { width: 100%; display: flex; flex-direction: column; align-items: center; }
  .product { position: relative; width: 100%; min-height: 560px; padding: 36px; display: flex; justify-content: center; align-items: center; border-radius: 16px; overflow: clip; background: var(--accent-soft); }
  .product::after { position: absolute; inset: 0; content: ""; background: rgba(241, 247, 253, 0.26); }
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .script-tool { position: relative; z-index: 1; width: 92%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 0.88fr); gap: 16px; }
  .tool-inputs, .tool-result { min-width: 0; padding: 24px; border: 1px solid rgba(35, 77, 128, 0.14); border-radius: 16px; background: rgba(255, 255, 255, 0.96); box-shadow: 0 18px 52px rgba(31, 71, 121, 0.12); }
  .tool-inputs { display: flex; flex-direction: column; gap: 16px; }
  .tool-heading, .result-number { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .tool-heading { padding-bottom: 2px; }
  .tool-heading .t-eyebrow { margin: 0; color: var(--accent-strong); }
  .tool-local { color: var(--grey); font-size: 12px; }
  .mode-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .network-field { display: flex; align-items: center; gap: 7px; color: var(--grey); font-size: 11px; }
  .network-field select { min-height: 34px; padding: 6px 26px 6px 9px; border: 1px solid var(--grey-20); border-radius: 7px; color: var(--black); background: var(--white); font-size: 12px; }
  .editor-field { display: flex; min-width: 0; flex-direction: column; gap: 8px; }
  .editor-field[hidden], .result-breakdown[hidden], .result-evidence[hidden], .result-scripts[hidden] { display: none; }
  .editor-field label { color: var(--black); font-size: 13px; font-weight: 650; }
  .sample-switch { display: inline-flex; align-self: flex-start; gap: 4px; padding: 4px; border: 1px solid var(--grey-20); border-radius: 8px; background: #f5f8fc; }
  .sample-switch button { min-height: 34px; padding: 7px 11px; border: 0; border-radius: 6px; color: var(--grey); background: transparent; cursor: pointer; font-size: 12px; }
  .sample-switch button[aria-pressed="true"] { color: var(--accent-strong); background: var(--white); box-shadow: 0 1px 4px rgba(31, 71, 121, 0.14); }
  .sample-switch--examples { align-self: flex-start; }
  .editor-field input { width: 100%; min-height: 46px; padding: 12px; border: 1px solid var(--grey-20); border-radius: 8px; color: var(--black); background: #f7f9fc; font: 13px/1.5 var(--font-mono); }
  .editor-field textarea { width: 100%; min-height: 228px; padding: 12px; border: 1px solid var(--grey-20); border-radius: 8px; color: var(--black); background: #f7f9fc; font: 12px/1.65 var(--font-mono); resize: vertical; }
  .field-hint { margin: 0; color: var(--grey); font-size: 12px; line-height: 1.5; }
  .scan-button, .action-button { min-height: 38px; padding: 9px 13px; border: 1px solid var(--grey-20); border-radius: 8px; color: var(--black); background: var(--white); cursor: pointer; font-size: 12px; font-weight: 600; }
  .scan-button { align-self: flex-start; border-color: var(--accent); color: var(--white); background: var(--accent); }
  .scan-button:disabled { opacity: .65; cursor: progress; }
  .scan-button:hover, .action-primary:hover { background: var(--accent-strong); }
  .action-button:disabled { color: #8a98a8; background: #f3f6fa; cursor: not-allowed; }
  .action-button:focus-visible, .scan-button:focus-visible, .sample-switch button:focus-visible, .editor-field textarea:focus-visible, .editor-field input:focus-visible, .network-field select:focus-visible, .saved-scripts button:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  :global(.script-row button:focus-visible) { outline: 2px solid var(--accent-strong); outline-offset: 2px; }
  .tool-result { display: flex; flex-direction: column; align-items: flex-start; }
  .result-head { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .result-state { padding: 5px 8px; border: 1px solid var(--grey-20); border-radius: 999px; color: var(--grey); font-size: 10px; white-space: nowrap; }
  .result-state[data-state="ready"] { color: #187244; border-color: #b8dfc8; background: #effaf3; }
  .result-state[data-state="warning"] { color: #805222; border-color: #f0d7ae; background: #fff8eb; }
  .result-state[data-state="error"] { color: #87333a; border-color: #efc2c2; background: #fff0f0; }
  .tool-result .t-eyebrow { margin: 0; color: var(--accent-strong); }
  .result-title { margin: 14px 0 8px; color: var(--black); font-size: 25px; font-weight: 600; line-height: 1.2; }
  .result-period { min-height: 34px; margin-bottom: 14px; color: var(--grey); font-size: 13px; line-height: 1.45; }
  .result-breakdown { width: 100%; margin: 0 0 14px; border-top: 1px solid var(--grey-20); }
  .result-breakdown :global(div) { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--grey-20); }
  .result-breakdown :global(dt), .result-breakdown :global(dd) { margin: 0; font-size: 11px; line-height: 1.4; }
  .result-breakdown :global(dt) { flex: 0 0 112px; color: var(--grey); }
  .result-breakdown :global(dd) { min-width: 0; color: var(--black); font-weight: 600; text-align: right; overflow-wrap: anywhere; }
  .result-breakdown :global(dd code) { font: 11px/1.5 var(--font-mono); overflow-wrap: anywhere; }
  .check-status { width: 100%; margin: 0 0 10px; padding: 8px 10px; border-radius: 8px; color: var(--accent-strong); background: var(--accent-soft); font-size: 11px; line-height: 1.4; }
  .check-status[data-state="review"] { color: #805222; background: #fff5e9; }
  .check-status[data-state="error"] { color: #87333a; background: #fff0f0; }
  .result-evidence, .result-scripts { width: 100%; margin: 5px 0 12px; padding-top: 12px; border-top: 1px solid var(--grey-20); }
  :global(.result-section-title) { margin-bottom: 8px; color: var(--black); font-size: 12px; font-weight: 650; }
  :global(.evidence-row) { display: grid; grid-template-columns: minmax(82px, 0.65fr) minmax(0, 1fr); align-items: start; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--grey-20); }
  :global(.script-row) { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start; gap: 10px; padding: 7px 0; border-bottom: 1px solid var(--grey-20); }
  :global(.evidence-row span), :global(.script-row span) { color: var(--grey); font-size: 10px; }
  :global(.evidence-row code), :global(.evidence-row a), :global(.script-row code) { min-width: 0; color: var(--black); font: 10px/1.4 var(--font-mono); overflow-wrap: anywhere; text-align: right; }
  :global(.script-row > div) { min-width: 0; }
  :global(.script-row button) { flex: none; color: var(--accent-strong); font-size: 10px; text-decoration: underline; text-underline-offset: 3px; }
  :global(.evidence-link) { color: var(--accent-strong); font-size: 10px; text-decoration: underline; }
  :global(.history-list) { display: grid; gap: 8px; margin-top: 10px; }
  :global(.history-item) { padding: 9px; border: 1px solid var(--grey-20); border-radius: 7px; background: #f9fbfd; }
  :global(.history-item strong) { display: block; margin-bottom: 5px; color: var(--black); font-size: 10px; }
  :global(.history-item a) { display: block; margin-top: 4px; color: var(--accent-strong); font: 10px/1.4 var(--font-mono); overflow-wrap: anywhere; }
  :global(.history-item code) { display: block; margin-top: 4px; color: var(--grey); font: 10px/1.4 var(--font-mono); overflow-wrap: anywhere; }
  .provider-note { margin: -6px 0 0; color: var(--grey); font-size: 10px; }
  .saved-scripts { width: 100%; margin-top: 18px; border-top: 1px solid var(--grey-20); }
  .saved-heading { display: flex; justify-content: space-between; gap: 12px; padding: 14px 0 8px; }
  .saved-heading h3 { font-size: 13px; font-weight: 650; }
  .saved-heading span { color: var(--grey); font-size: 11px; }
  .saved-scripts ul { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
  .saved-scripts :global(li) { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 0; border-top: 1px solid var(--grey-20); }
  .saved-scripts :global(li code) { min-width: 0; overflow: hidden; color: var(--dark-grey); font: 10px var(--font-mono); text-overflow: ellipsis; white-space: nowrap; }
  .saved-scripts :global(li button) { flex: none; color: var(--accent-strong); font-size: 11px; text-decoration: underline; text-underline-offset: 3px; }
  #save-script { margin-top: 4px; }
  .action-primary { border-color: var(--accent); color: var(--white); background: var(--accent); }
  .stats { width: 100%; display: flex; align-items: stretch; gap: 12px; padding: 16px 0 0; }
  .stat { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; padding: 24px; border-radius: 16px; background: var(--surface); overflow: clip; }
  .stat .t-eyebrow { font-size: 12px; }

  @media (max-width: 1199.98px) {
    .hero-top { flex-direction: column; align-items: flex-start; gap: 28px; }
    .hero-title, .side { width: 100%; }
    .side { max-width: 520px; }
    .product { min-height: 520px; padding: 28px; }
    .script-tool { width: 100%; }
  }
  @media (max-width: 809.98px) {
    .hero { padding: 48px 20px 64px; gap: 32px; }
    .hero-top { gap: 20px; }
    .product { min-height: auto; padding: 16px; }
    .script-tool { grid-template-columns: 1fr; gap: 10px; }
    .tool-inputs, .tool-result { padding: 18px; }
    .tool-inputs { gap: 14px; }
    .mode-row { align-items: flex-start; flex-direction: column; }
    .network-field { align-self: flex-end; }
    .editor-field textarea { min-height: 184px; }
    .result-title { font-size: 25px; }
    .stats { flex-direction: column; gap: 10px; }
    .stat { width: 100%; flex: none; padding: 18px 20px; }
  }
</style>
