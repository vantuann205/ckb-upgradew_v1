---
---
<section class="model-section" id="script-rules">
  <div class="model-title">
    <p class="t-eyebrow">How to read a result</p>
    <h2 class="t-h2 balance">One field answers one part of the question</h2>
    <p class="t-body-m">The Script tells you how code is referenced. The live cell lock authorizes spending; its Type Script also constrains what can replace it.</p>
  </div>
  <div class="model-grid">
    <div class="method-console">
      <div class="method-tabs" role="tablist" aria-label="Script reference details">
        <button class="method-tab is-active" id="method-tab-data" type="button" role="tab" aria-selected="true" aria-controls="method-panel" tabindex="0" data-method-tab="data">data / data1 / data2</button>
        <button class="method-tab" id="method-tab-type" type="button" role="tab" aria-selected="false" aria-controls="method-panel" tabindex="-1" data-method-tab="type">type</button>
        <button class="method-tab" id="method-tab-lock" type="button" role="tab" aria-selected="false" aria-controls="method-panel" tabindex="-1" data-method-tab="lock">Who controls it?</button>
        <button class="method-tab" id="method-tab-limits" type="button" role="tab" aria-selected="false" aria-controls="method-panel" tabindex="-1" data-method-tab="limits">Limits</button>
      </div>
      <div class="method-panel" id="method-panel" role="tabpanel" tabindex="0" aria-labelledby="method-tab-data">
        <div class="method-panel-heading">
          <div>
            <span class="method-language">Reference behavior</span>
            <p id="method-copy">These hash types point directly to a script binary hash. A replacement binary has a different hash, so this reference does not follow it automatically.</p>
          </div>
          <a href="#references">View CKB references</a>
        </div>
        <div class="method-code-actions">
          <button class="copy-button" id="method-copy-button" type="button">Copy example</button>
          <span class="copy-status" id="method-copy-status" role="status" aria-live="polite"></span>
        </div>
        <pre><code id="method-code">hash_type: "data1"
code_hash: hash of the script binary

same reference -> same binary hash</code></pre>
      </div>
    </div>
    <aside class="assumption-list" aria-label="What a script check can establish">
      <div class="assumption">
        <span class="assumption-value">Reference</span>
        <div>
          <h3 class="t-h5">Read hash_type</h3>
          <p class="t-body-s">It identifies how the script locates code, not what the code does.</p>
        </div>
      </div>
      <div class="assumption">
        <span class="assumption-value">Lock</span>
        <div>
          <h3 class="t-h5">Inspect the live code cell</h3>
          <p class="t-body-s">Its lock authorizes spending; its Type Script validates replacement outputs.</p>
        </div>
      </div>
      <div class="assumption">
        <span class="assumption-value">Evidence</span>
        <div>
          <h3 class="t-h5">Verify each change</h3>
          <p class="t-body-s">Use the transaction and block that replaced the code cell.</p>
        </div>
      </div>
      <p class="assumption-limit">This MVP queries live CKB data and traces bounded Type ID history. Custom lock logic stays unidentified; no wallet or alerts are connected.</p>
    </aside>
  </div>
</section>
<script>
  import { bindModelNotes } from '../../model-notes';
  bindModelNotes();
</script>
<style>
  .model-section { width: 100%; max-width: var(--canvas); margin: 0 auto; padding: 100px 20px; display: flex; flex-direction: column; align-items: center; gap: 56px; }
  .model-title { width: 700px; display: flex; flex-direction: column; align-items: center; gap: 20px; text-align: center; }
  .model-title .t-body-m { max-width: 650px; line-height: 1.5; }
  .model-grid { width: 100%; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr); align-items: stretch; gap: 16px; }
  .method-console { min-width: 0; padding: 24px; border: 1px solid var(--grey-20); border-top: 3px solid var(--accent); border-radius: 12px; background: var(--white); box-shadow: 0 14px 34px rgba(31, 71, 121, 0.08); }
  .method-tabs { display: flex; gap: 6px; padding-bottom: 18px; border-bottom: 1px solid var(--grey-20); overflow-x: auto; }
  .method-tab { flex: 0 0 auto; padding: 9px 13px; border: 1px solid transparent; border-radius: 6px; color: var(--grey); background: transparent; cursor: pointer; font-size: 12px; transition: color 180ms ease, background 180ms ease, border-color 180ms ease; }
  .method-tab:hover { color: var(--accent-strong); }
  .method-tab.is-active { border-color: rgba(33, 102, 197, 0.2); color: var(--accent-strong); background: var(--accent-soft); }
  .method-panel { min-width: 0; padding-top: 24px; }
  .method-panel-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; }
  .method-language { display: block; margin-bottom: 10px; color: var(--accent-strong); font-family: var(--font-mono); font-size: 11px; }
  .method-panel-heading p { max-width: 470px; margin: 0; color: var(--grey); font-size: 14px; line-height: 1.5; }
  .method-panel-heading a { flex: none; color: var(--accent-strong); font-size: 12px; text-decoration: underline; text-underline-offset: 3px; }
  .method-code-actions { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 24px; }
  .copy-button { padding: 8px 12px; border: 1px solid var(--grey-20); border-radius: 6px; color: var(--black); background: var(--white); cursor: pointer; font-size: 12px; transition: color 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .copy-button:hover { color: var(--accent-strong); border-color: var(--accent); }
  .copy-button:active { transform: translateY(1px); }
  .copy-status { color: var(--grey); font-size: 12px; }
  .method-panel pre { position: relative; max-width: 100%; margin: 0; padding: 48px 22px 22px; overflow-x: auto; border: 1px solid rgba(35, 77, 128, 0.14); border-left: 3px solid var(--accent); border-radius: 8px; color: var(--black); background: #f1f6fc; font: 13px/1.9 var(--font-mono); font-variant-numeric: tabular-nums; }
  .method-panel pre::before { position: absolute; top: 15px; left: 22px; color: var(--accent-strong); content: "DOCUMENTED REPLACEMENT"; font: 10px/1.2 var(--font-mono); }
  .method-panel code { white-space: pre-wrap; overflow-wrap: anywhere; }
  .assumption-list { min-width: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; }
  .assumption { display: grid; grid-template-columns: 110px minmax(0, 1fr); align-items: center; gap: 18px; min-height: 100px; padding: 18px 20px; border: 1px solid var(--grey-20); border-radius: 12px; background: var(--surface); }
  .assumption-value { color: var(--accent-strong); font-family: var(--font-mono); font-size: 16px; white-space: nowrap; }
  .assumption h3 { margin-bottom: 6px; font-size: 16px; }
  .assumption p { margin: 0; line-height: 1.45; }
  .assumption-limit { margin: 0; padding: 14px 2px 0; color: var(--grey); font-size: 12px; line-height: 1.55; }
  @media (max-width: 1199.98px) {
    .model-title { width: 100%; }
    .model-grid { grid-template-columns: 1fr; }
    .assumption-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .assumption-limit { grid-column: 1 / -1; }
  }
  @media (max-width: 809.98px) {
    .model-section { padding: 64px 20px; gap: 32px; }
    .method-console { padding: 18px; }
    .method-panel-heading { flex-direction: column; }
    .assumption-list { display: flex; }
    .assumption { grid-template-columns: 100px minmax(0, 1fr); }
  }
</style>
